*
  margin 0
  padding 0
  margin-block-start 0
  margin-block-end 0
  font-size 14px
  text-rendering optimizeLegibility
  -webkit-font-smoothing none

body
  font-family monospace
  max-width 850px
  margin 0 auto
  color #444

@media print
  *
    font-size 8pt

header
  display flex
  align-items center
  background aquamarine
  h1
    flex 1
  ul.links
    font-size 0.8rem
    flex 1
    padding 0
    display flex
    flex-wrap wrap
    li
      list-style-type none
      margin 0 20px
      a
        margin-left 10px

header, main > section
  position relative
  padding 10px
  margin-bottom 1em
  @media print
    margin-bottom 0.5em
  &:last-child
    margin-bottom 0

.aquamarine-splashed
  &:before
    margin-left -10px
    z-index -1
    width 10em
    height 1em
    display block
    content ''
    background aquamarine
    margin-bottom -0.8em
    @media print
      margin-bottom -10px


h2
  @extend .aquamarine-splashed
  margin-top -1em
  margin-bottom 0.8em
  @media print
    margin-bottom 0.3em

h1
  font-size 1.8rem
h2
  font-size 1.3rem
h3
  font-size 1.1rem

section.engineering-skills-and-interests
  display flex
  flex-wrap wrap
  h2
    flex 0 0 100%
  section
    padding-left 40px
    max-width 33%
    flex 1
    aside
      margin-left 1rem
      font-style italic
      color #999
    ul, ol
      margin 0
      flex 1 1 100%
      padding 0
    &.additional ul
      display flex
      flex-wrap wrap
      li
        flex 1 0 50%

a
  font-size inherit

ul
  list-style-type none

p.description
  margin 0.25em 1em 0.5em 1em

.highlight
  border-left 5px solid aquamarine
  padding-left 0.5em

dd > small.tiny-note
  position relative
  top -0.66em

small.tiny-note
  color #999
  font-size 75%
  font-style italic
  margin-left 3em
  margin-top -0.66em

small.side-link
  font-style italic
  margin-left 0.5em

p.just-for-fun
  @extend small.tiny-note
  margin-top 0.25em

ul.jobs
  li
    margin-bottom 0.5em
    display flex
    flex-wrap wrap
    align-items baseline
    &:last-child
      margin-bottom 0
    .place, .period
      flex 1
    .title
      margin-right 0.5em
    .place
      color #999
      font-style italic
      &:before
        content " @ "
    .period
      text-align right
    .period
      color #999
    .description
      width 100%
    .technologies
      break

dl, ul.jobs dl
  margin 0
  margin-left 2em
  dd
    p.description
      font-size 0.85em
  dt
    display flex
    align-items center
    margin-bottom -0.4em
    small a
      font-size 80%

span.technology
  background peachpuff
  margin 5px 0px
  padding 3px
  font-size 75%
  height fit-content

ul.technologies
  display flex
  li
    background peachpuff
    margin 5px
    padding 3px
    font-size 75%
    height fit-content

section.education
  .northwestern
    display flex
    align-items baseline
    small
      margin-left 1.5em
      &.degree
        font-style italic

p span.revision
  font-size 66%
  padding 3px
  color #999
  position fixed
  bottom 0
